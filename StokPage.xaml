<?xml version="1.0" encoding="utf-8" ?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="ApotekApp.StokPage" BackgroundColor="#F1F3F5"><Grid Padding="20" RowDefinitions="Auto,*" RowSpacing="12"><Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8"><Border BackgroundColor="White" Stroke="#B8C3CF" StrokeShape="RoundRectangle 8" Padding="10,0"><Entry x:Name="TxtSearch" TextColor="#0F172A" PlaceholderColor="#94A3B8" Placeholder="Cari obat / referensi..." TextChanged="OnSearchChanged"/></Border><Border Grid.Column="1" Style="{StaticResource FormPickerBorder}"><Picker x:Name="CmbJenis" TextColor="#0F172A" TitleColor="#64748B" Title="Semua Mutasi" SelectedIndexChanged="OnFilterChanged" ZIndex="110"><Picker.Items><x:String>Semua Mutasi</x:String><x:String>Penyesuaian</x:String><x:String>Pembelian</x:String><x:String>Penjualan</x:String><x:String>Retur</x:String></Picker.Items></Picker></Border><Button Grid.Column="2" Text="↻ Refresh" Clicked="OnRefreshClicked" BackgroundColor="White" TextColor="#334155" BorderColor="#B8C3CF" BorderWidth="1"/><Button Grid.Column="3" Text="+ Penyesuaian Stok" Clicked="OnAdjustClicked" BackgroundColor="#0F766E" TextColor="White"/></Grid><Border Grid.Row="1" BackgroundColor="White" Stroke="#C7D0DA" StrokeShape="RoundRectangle 12"><Grid RowDefinitions="Auto,*"><Grid Padding="14" ColumnDefinitions="145,*,110,90,100,150" BackgroundColor="#F1F3F5"><Label Text="WAKTU" FontAttributes="Bold" FontSize="10" TextColor="#334155"/><Label Grid.Column="1" Text="OBAT" FontAttributes="Bold" FontSize="10" TextColor="#334155"/><Label Grid.Column="2" Text="JENIS" FontAttributes="Bold" FontSize="10" TextColor="#334155"/><Label Grid.Column="3" Text="QTY" FontAttributes="Bold" FontSize="10" TextColor="#334155"/><Label Grid.Column="4" Text="STOK" FontAttributes="Bold" FontSize="10" TextColor="#334155"/><Label Grid.Column="5" Text="REFERENSI" FontAttributes="Bold" FontSize="10" TextColor="#334155"/></Grid><CollectionView Grid.Row="1" x:Name="Cv"><CollectionView.EmptyView><VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="4"><Label Text="Belum ada mutasi stok" FontSize="16" FontAttributes="Bold" TextColor="#475569" HorizontalTextAlignment="Center"/><Label Text="Gunakan Penyesuaian Stok atau lakukan transaksi." FontSize="11" TextColor="#94A3B8" HorizontalTextAlignment="Center"/></VerticalStackLayout></CollectionView.EmptyView><CollectionView.ItemTemplate><DataTemplate><Grid Padding="12,9" ColumnDefinitions="145,*,110,90,100,150"><Label Text="{Binding Waktu}" FontSize="10" VerticalOptions="Center" TextColor="#64748B"/><Label Grid.Column="1" Text="{Binding Obat}" FontAttributes="Bold" VerticalOptions="Center" TextColor="#0F172A"/><Label Grid.Column="2" Text="{Binding Jenis}" VerticalOptions="Center" TextColor="#0F766E"/><Label Grid.Column="3" Text="{Binding Qty}" VerticalOptions="Center" TextColor="#334155"/><Label Grid.Column="4" Text="{Binding Stok}" VerticalOptions="Center" TextColor="#059669" FontAttributes="Bold"/><Label Grid.Column="5" Text="{Binding Ref}" FontSize="10" VerticalOptions="Center" TextColor="#64748B"/></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView></Grid></Border><Grid x:Name="Modal" Grid.RowSpan="2" IsVisible="False" BackgroundColor="#880F172A"><Border WidthRequest="500" HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="20"><VerticalStackLayout Spacing="10"><Grid ColumnDefinitions="*,Auto"><Label Text="Penyesuaian Stok" FontSize="19" FontAttributes="Bold" TextColor="#0F172A"/><Button Grid.Column="1" Text="✕" Clicked="OnBatalClicked" BackgroundColor="#F1F3F5" TextColor="#334155" WidthRequest="38"/></Grid><VerticalStackLayout Style="{StaticResource FormPickerContainer}" Spacing="4"><Label Text="Obat" FontSize="12" FontAttributes="Bold" TextColor="#334155"/><Border Style="{StaticResource FormPickerBorder}"><Picker x:Name="CmbObat" Title="Pilih obat" TextColor="#0F172A" TitleColor="#94A3B8" BackgroundColor="Transparent" ZIndex="110"/></Border></VerticalStackLayout><VerticalStackLayout Style="{StaticResource FormPickerContainer}" Spacing="4"><Label Text="Jenis penyesuaian" FontSize="12" FontAttributes="Bold" TextColor="#334155"/><Border Style="{StaticResource FormPickerBorder}"><Picker x:Name="CmbArah" Title="Pilih jenis" TextColor="#0F172A" TitleColor="#94A3B8" BackgroundColor="Transparent" ZIndex="110"><Picker.Items><x:String>Stok Masuk</x:String><x:String>Stok Keluar</x:String></Picker.Items></Picker></Border></VerticalStackLayout><VerticalStackLayout Spacing="4"><Label Text="Jumlah" FontSize="12" FontAttributes="Bold" TextColor="#334155"/><Border BackgroundColor="#F8FAFC" Stroke="#B8C3CF" StrokeShape="RoundRectangle 8" Padding="8,0" HeightRequest="46"><Entry x:Name="TxtQty" Placeholder="Jumlah" Keyboard="Numeric" TextColor="#0F172A" PlaceholderColor="#94A3B8" BackgroundColor="Transparent"/></Border></VerticalStackLayout><VerticalStackLayout Spacing="4"><Label Text="Referensi / alasan" FontSize="12" FontAttributes="Bold" TextColor="#334155"/><Border BackgroundColor="#F8FAFC" Stroke="#B8C3CF" StrokeShape="RoundRectangle 8" Padding="8,0" HeightRequest="46"><Entry x:Name="TxtRef" Placeholder="Referensi / alasan" TextColor="#0F172A" PlaceholderColor="#94A3B8" BackgroundColor="Transparent"/></Border></VerticalStackLayout><HorizontalStackLayout HorizontalOptions="End" Spacing="8"><Button Text="Batal" Clicked="OnBatalClicked" BackgroundColor="#C7D0DA" TextColor="#334155"/><Button Text="Simpan" Clicked="OnSimpanClicked" BackgroundColor="#16A34A" TextColor="White"/></HorizontalStackLayout></VerticalStackLayout></Border></Grid></Grid></ContentPage>
