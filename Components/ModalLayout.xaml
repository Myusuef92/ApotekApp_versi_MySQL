<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ApotekApp.Components.ModalLayout"
             x:Name="self"
             BackgroundColor="#80000000"
             HorizontalOptions="Fill"
             VerticalOptions="Fill">

    <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
        <!-- KUNCI LEBAR MODAL DENGAN WidthRequest="520" DAN HorizontalOptions="Center" -->
        <Border BackgroundColor="White" 
                WidthRequest="520" 
                HorizontalOptions="Center" 
                VerticalOptions="Center" 
                Padding="26" 
                StrokeThickness="0"
                Margin="16">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16"/>
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto, *, Auto" RowSpacing="18">
                <!-- JUDUL MODAL -->
                <Label Grid.Row="0" 
                       Text="{Binding Title, Source={x:Reference self}}" 
                       FontSize="21" 
                       FontAttributes="Bold" 
                       TextColor="#0F172A"/>

                <!-- CONTAINER FORM -->
                <ScrollView Grid.Row="1" MaximumHeightRequest="500" VerticalScrollBarVisibility="Never">
                    <ContentPresenter />
                </ScrollView>

                <!-- TOMBOL ACTION -->
                <Grid Grid.Row="2" ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,10,0,0">
                    <Button Grid.Column="0" 
                            Text="Batal" 
                            Clicked="OnBatalClicked" 
                            BackgroundColor="#64748B" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            CornerRadius="8" 
                            HeightRequest="46"/>
                    <Button Grid.Column="1" 
                            Text="Simpan" 
                            Clicked="OnSimpanClicked" 
                            BackgroundColor="#0F766E" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            CornerRadius="8" 
                            HeightRequest="46"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentView>