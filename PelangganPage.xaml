<?xml version="1.0" encoding="utf-8" ?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="ApotekApp.PelangganPage" BackgroundColor="#F1F3F5"><Grid Padding="20" RowDefinitions="Auto,*" RowSpacing="12"><Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><Border BackgroundColor="White" Stroke="#B8C3CF" StrokeShape="RoundRectangle 8" Padding="10,0"><Entry x:Name="TxtSearch" Placeholder="Cari No. RM, nama, NIK, telepon..." TextChanged="OnSearchChanged"/></Border><Button Grid.Column="1" Text="↻ Refresh" Clicked="OnRefreshClicked" BackgroundColor="White" TextColor="#334155" BorderColor="#B8C3CF" BorderWidth="1"/><Button Grid.Column="2" Text="+ Tambah Pasien" Clicked="OnTambahClicked" BackgroundColor="#0F766E" TextColor="White"/></Grid><Border Grid.Row="1" BackgroundColor="White" Stroke="#C7D0DA" StrokeShape="RoundRectangle 12"><Grid RowDefinitions="Auto,*"><Grid Padding="14" ColumnDefinitions="120,*,130,140,100" BackgroundColor="#F1F3F5"><Label Text="NO. RM" FontAttributes="Bold" FontSize="10"/><Label Grid.Column="1" Text="NAMA" FontAttributes="Bold" FontSize="10"/><Label Grid.Column="2" Text="TELEPON" FontAttributes="Bold" FontSize="10"/><Label Grid.Column="3" Text="SATUSEHAT ID" FontAttributes="Bold" FontSize="10"/><Label Grid.Column="4" Text="AKSI" FontAttributes="Bold" FontSize="10"/></Grid><CollectionView Grid.Row="1" x:Name="Cv"><CollectionView.EmptyView><Label Text="Belum ada data pasien." HorizontalOptions="Center" VerticalOptions="Center" TextColor="#94A3B8"/></CollectionView.EmptyView><CollectionView.ItemTemplate><DataTemplate><Grid Padding="12,8" ColumnDefinitions="120,*,130,140,100"><Label Text="{Binding NoRM}" VerticalOptions="Center" TextColor="#0F766E" FontAttributes="Bold"/><VerticalStackLayout Grid.Column="1"><Label Text="{Binding Nama}" FontAttributes="Bold" TextColor="#0F172A"/><Label Text="{Binding Alamat}" FontSize="10" TextColor="#64748B" LineBreakMode="TailTruncation"/></VerticalStackLayout><Label Grid.Column="2" Text="{Binding Telepon}" VerticalOptions="Center" TextColor="#475569"/><Label Grid.Column="3" Text="{Binding SatusehatId}" VerticalOptions="Center" FontSize="10" TextColor="#475569"/><Button Grid.Column="4" Text="Edit" Clicked="OnEditClicked" CommandParameter="{Binding .}" HeightRequest="32" BackgroundColor="#F59E0B" TextColor="White"/></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView></Grid></Border><Grid x:Name="Modal" IsVisible="False" BackgroundColor="#880F172A" Grid.RowSpan="2"><Border WidthRequest="560" HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="20"><ScrollView><VerticalStackLayout Spacing="9"><Grid ColumnDefinitions="*,Auto"><Label x:Name="LblTitle" Text="Tambah Pasien" FontSize="19" FontAttributes="Bold" TextColor="#0F172A"/><Button Grid.Column="1" Text="✕" Clicked="OnBatalClicked" BackgroundColor="#F1F3F5" TextColor="#334155" WidthRequest="38"/></Grid><VerticalStackLayout Spacing="4"><Label Text="No. RM" FontSize="12" FontAttributes="Bold" TextColor="#334155"/><Border Style="{StaticResource FormFieldBorder}"><Entry x:Name="TxtRM" Placeholder="Kosongkan untuk otomatis" TextColor="#0F172A" PlaceholderColor="#94A3B8" BackgroundColor="Transparent"/></Border></VerticalStackLayout><VerticalStackLayout Spacing="4"><Label Text="Nama pasien *" FontSize="12" FontAttributes="Bold" TextColor="#334155"/><Border Style="{StaticResource FormFieldBorder}"><Entry x:Name="TxtNama" Placeholder="Nama lengkap pasien" TextColor="#0F172A" PlaceholderColor="#94A3B8" BackgroundColor="Transparent"/></Border></VerticalStackLayout><VerticalStackLayout Spacing="4"><Label Text="NIK" FontSize="12" FontAttributes="Bold" TextColor="#334155"/><Border Style="{StaticResource FormFieldBorder}"><Entry x:Name="TxtNIK" Placeholder="Nomor NIK" TextColor="#0F172A" PlaceholderColor="#94A3B8" BackgroundColor="Transparent"/></Border></VerticalStackLayout><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><VerticalStackLayout Style="{StaticResource FormPickerContainer}" Spacing="4"><Label Text="Jenis kelamin" FontSize="12" FontAttributes="Bold" TextColor="#334155"/><Border Style="{StaticResource FormPickerBorder}"><Picker x:Name="CmbJK" Title="Jenis kelamin" TextColor="#0F172A" TitleColor="#94A3B8" BackgroundColor="Transparent" ZIndex="110"><Picker.Items><x:String>Laki-laki</x:String><x:String>Perempuan</x:String></Picker.Items></Picker></Border></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="Tanggal lahir" FontSize="12" FontAttributes="Bold" TextColor="#334155"/><Border Style="{StaticResource FormFieldBorder}"><DatePicker x:Name="DtpLahir"/></Border></VerticalStackLayout></Grid><VerticalStackLayout Spacing="4"><Label Text="No. telepon" FontSize="12" FontAttributes="Bold" TextColor="#334155"/><Border Style="{StaticResource FormFieldBorder}"><Entry x:Name="TxtTelepon" Placeholder="08xxxxxxxxxx" TextColor="#0F172A" PlaceholderColor="#94A3B8" BackgroundColor="Transparent"/></Border></VerticalStackLayout><VerticalStackLayout Spacing="4"><Label Text="Alamat" FontSize="12" FontAttributes="Bold" TextColor="#334155"/><Border Style="{StaticResource FormFieldBorder}"><Entry x:Name="TxtAlamat" Placeholder="Alamat lengkap pasien" TextColor="#0F172A" PlaceholderColor="#94A3B8" BackgroundColor="Transparent"/></Border></VerticalStackLayout><VerticalStackLayout Spacing="4"><Label Text="Alergi obat / catatan alergi" FontSize="12" FontAttributes="Bold" TextColor="#334155"/><Border Style="{StaticResource FormFieldBorder}"><Entry x:Name="TxtAlergi" Placeholder="Tuliskan alergi jika ada" TextColor="#0F172A" PlaceholderColor="#94A3B8" BackgroundColor="Transparent"/></Border></VerticalStackLayout><VerticalStackLayout Spacing="4"><Label Text="SATUSEHAT ID (opsional)" FontSize="12" FontAttributes="Bold" TextColor="#334155"/><Border Style="{StaticResource FormFieldBorder}"><Entry x:Name="TxtSatusehat" Placeholder="Masukkan ID jika tersedia" TextColor="#0F172A" PlaceholderColor="#94A3B8" BackgroundColor="Transparent"/></Border></VerticalStackLayout><HorizontalStackLayout HorizontalOptions="End" Spacing="8"><Button Text="Batal" Clicked="OnBatalClicked" BackgroundColor="#C7D0DA" TextColor="#334155"/><Button Text="Simpan Pasien" Clicked="OnSimpanClicked" BackgroundColor="#16A34A" TextColor="White"/></HorizontalStackLayout></VerticalStackLayout></ScrollView></Border></Grid></Grid></ContentPage>
