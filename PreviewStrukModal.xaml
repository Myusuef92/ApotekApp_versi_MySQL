                    <Label x:Name="LblSubtotal" Text="Rp 0" FontSize="11" TextColor="#111827" Grid.Row="0" Grid.Column="1"/>

                    <Label Text="Diskon" FontSize="11" TextColor="#4B5563" Grid.Row="1" Grid.Column="0"/>
