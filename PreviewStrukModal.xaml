                    <Label Text="PPN (0%)" FontSize="11" TextColor="#4B5563" Grid.Row="2" Grid.Column="0"/>
                    <Label x:Name="LblPpn" Text="Rp 0" FontSize="11" TextColor="#111827" Grid.Row="2" Grid.Column="1"/>

                    <Label Text="Grand Total" FontSize="12" FontAttributes="Bold" TextColor="#111827" Grid.Row="3" Grid.Column="0"/>
                    <Label x:Name="LblGrandTotal" Text="Rp 0" FontSize="12" FontAttributes="Bold" TextColor="#111827" Grid.Row="3" Grid.Column="1"/>

                    <Label Text="Bayar" FontSize="11" TextColor="#4B5563" Grid.Row="4" Grid.Column="0"/>
                    <Label x:Name="LblBayar" Text="Rp 0" FontSize="11" TextColor="#111827" Grid.Row="4" Grid.Column="1"/>

                    <Label Text="Kembali" FontSize="11" FontAttributes="Bold" TextColor="#16A34A" Grid.Row="5" Grid.Column="0"/>
                    <Label x:Name="LblKembali" Text="Rp 0" FontSize="11" FontAttributes="Bold" TextColor="#16A34A" Grid.Row="5" Grid.Column="1"/>
                </Grid>

                <Label Text="-- Terima Kasih Semoga Lekas Sembuh --"
                       FontSize="10"
                       HorizontalTextAlignment="Center"
                       TextColor="#9CA3AF"
                       Margin="0,10,0,5" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Text="Cetak Struk"
                            Clicked="OnCetakStrukClicked"
