<maui:MauiWinUIApplication
    x:Class="ApotekApp.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maui="using:Microsoft.Maui"
    xmlns:local="using:ApotekApp.WinUI">

    <maui:MauiWinUIApplication.Resources>
        <ResourceDictionary>
            <!-- Keep every MAUI Picker/WinUI ComboBox readable, including its flyout list. -->
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#F8FAFC" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#F1F5F9" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#0F172A" />
            <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#0F172A" />
            <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#0F172A" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="#0F172A" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#CBD5E1" />
            <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#0F172A" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#0F172A" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundPressed" Color="#0F172A" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#0F172A" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#0F172A" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="#0F172A" />
            <SolidColorBrush x:Key="ComboBoxItemBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#E7F3F1" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#D9ECE9" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#E7F3F1" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#D9ECE9" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#CDE5E1" />
            <SolidColorBrush x:Key="ComboBoxItemBorderBrush" Color="#E2E8F0" />
            <SolidColorBrush x:Key="ComboBoxItemBorderBrushPointerOver" Color="#CBD5E1" />
            <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelected" Color="#B8D8D2" />
        </ResourceDictionary>
    </maui:MauiWinUIApplication.Resources>
</maui:MauiWinUIApplication>
