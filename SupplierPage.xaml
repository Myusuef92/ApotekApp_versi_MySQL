<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="ApotekApp.SupplierPage" BackgroundColor="#F1F3F5">
<Grid RowDefinitions="Auto,Auto,*" Padding="24">
    <HorizontalStackLayout Grid.Row="0" Spacing="8" HorizontalOptions="End" Margin="0,0,0,12">
            <Button Text="🔄  Refresh" Clicked="OnRefreshClicked" BackgroundColor="White" TextColor="#334155" BorderColor="#B8C3CF" BorderWidth="1" CornerRadius="8" HeightRequest="42" Padding="16,0" />
            <Button Text="+ Tambah Supplier" Clicked="OnTambahSupplierClicked" BackgroundColor="#0F766E" TextColor="White"/></HorizontalStackLayout>
    <Border Grid.Row="1" BackgroundColor="White" Stroke="#B8C3CF" StrokeThickness="1.5" StrokeShape="RoundRectangle 9" Padding="10,0" Margin="0,0,0,12" HeightRequest="48"><Entry x:Name="TxtSearch" Placeholder="Cari nama, telepon, email atau alamat..." TextChanged="OnSearchTextChanged" BackgroundColor="Transparent"/></Border>
    <Border Grid.Row="2" BackgroundColor="White" Stroke="#B8C3CF" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="0" VerticalOptions="FillAndExpand">
        <Grid RowDefinitions="Auto,*">
            <Grid Padding="12" ColumnDefinitions="*,140,220,150" BackgroundColor="#C7D0DA"><Label Text="NAMA SUPPLIER" FontAttributes="Bold" TextColor="#334155"/><Label Grid.Column="1" Text="TELEPON" FontAttributes="Bold" TextColor="#334155"/><Label Grid.Column="2" Text="EMAIL" FontAttributes="Bold" TextColor="#334155"/><Label Grid.Column="3" Text="AKSI" FontAttributes="Bold" TextColor="#334155"/></Grid>
            <CollectionView Grid.Row="1" x:Name="CvSupplierList" VerticalOptions="FillAndExpand" MinimumHeightRequest="260"><CollectionView.EmptyView><Label Text="Data supplier belum tersedia" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#64748B"/></CollectionView.EmptyView><CollectionView.ItemTemplate><DataTemplate><Grid Padding="10,8" ColumnDefinitions="*,140,220,150" BackgroundColor="White" HeightRequest="48"><Label Text="{Binding NamaSupplier}" TextColor="#0F172A" FontAttributes="Bold" VerticalOptions="Center"/><Label Grid.Column="1" Text="{Binding Telepon}" TextColor="#334155" VerticalOptions="Center"/><Label Grid.Column="2" Text="{Binding Email}" TextColor="#334155" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                <HorizontalStackLayout Grid.Column="3" Spacing="6">
                  <Button Text="Edit" Clicked="OnEditClicked" CommandParameter="{Binding .}" HeightRequest="34" WidthRequest="62" BackgroundColor="#F59E0B" TextColor="White"/>
                                    <Button Text="Hapus" Clicked="OnHapusClicked" BindingContext="{Binding .}" CommandParameter="{Binding Id}" HeightRequest="34" WidthRequest="72" BackgroundColor="#DC2626" TextColor="White" FontAttributes="Bold" Padding="8,0" IsEnabled="True" InputTransparent="False" ZIndex="100" />
                </HorizontalStackLayout>
            </Grid>
            </DataTemplate>
            </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Border>
    <Grid x:Name="ModalLayout" Grid.RowSpan="3" IsVisible="False" BackgroundColor="#990F172A"><Border HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="560" BackgroundColor="White" Stroke="#B8C3CF" StrokeShape="RoundRectangle 16" Padding="24"><VerticalStackLayout Spacing="12"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label x:Name="LblModalTitle" Text="Tambah Supplier" FontSize="21" FontAttributes="Bold" TextColor="#0F172A"/><Label Text="Data supplier digunakan untuk transaksi pembelian." FontSize="12" TextColor="#64748B"/></VerticalStackLayout><Button Grid.Column="1" Text="✕" Clicked="OnBatalSupplierClicked" BackgroundColor="#F1F3F5" TextColor="#475569" WidthRequest="42" HeightRequest="42" Padding="0"/></Grid><VerticalStackLayout Spacing="4"><Label Text="Nama Supplier *" FontSize="12" FontAttributes="Bold" TextColor="#334155"/><Border Stroke="#B8C3CF" StrokeShape="RoundRectangle 8" Padding="8,0"><Entry x:Name="TxtNama" Placeholder="Nama perusahaan / supplier" TextColor="#0F172A" PlaceholderColor="#94A3B8"/></Border></VerticalStackLayout><VerticalStackLayout Spacing="4"><Label Text="Nomor Telepon" FontSize="12" FontAttributes="Bold" TextColor="#334155"/><Border Stroke="#B8C3CF" StrokeShape="RoundRectangle 8" Padding="8,0"><Entry x:Name="TxtTelepon" Placeholder="08xxxxxxxxxx" Keyboard="Telephone" TextColor="#0F172A" PlaceholderColor="#94A3B8"/></Border></VerticalStackLayout><VerticalStackLayout Spacing="4"><Label Text="Email" FontSize="12" FontAttributes="Bold" TextColor="#334155"/><Border Stroke="#B8C3CF" StrokeShape="RoundRectangle 8" Padding="8,0"><Entry x:Name="TxtEmail" Placeholder="supplier@email.com" Keyboard="Email" TextColor="#0F172A" PlaceholderColor="#94A3B8"/></Border></VerticalStackLayout><VerticalStackLayout Spacing="4"><Label Text="Alamat" FontSize="12" FontAttributes="Bold" TextColor="#334155"/><Border Stroke="#B8C3CF" StrokeShape="RoundRectangle 8" Padding="8"><Editor x:Name="TxtAlamat" Placeholder="Alamat lengkap supplier" TextColor="#0F172A" PlaceholderColor="#94A3B8" HeightRequest="90"/></Border></VerticalStackLayout><HorizontalStackLayout HorizontalOptions="End" Spacing="8"><Button Text="Batal" Clicked="OnBatalSupplierClicked" BackgroundColor="#C7D0DA" TextColor="#334155"/><Button Text="💾 Simpan Data" Clicked="OnSimpanSupplierClicked" BackgroundColor="#16A34A" TextColor="White" FontAttributes="Bold"/></HorizontalStackLayout></VerticalStackLayout></Border></Grid>
</Grid>
</ContentPage>
